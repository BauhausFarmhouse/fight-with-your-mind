<script>
(function () {
	// #fighting-text spans all 3 rows of the tile grid on the desktop
	// (>1024px) layout only. Its content is naturally a bit taller than
	// the six square tiles combined, which used to force extra blank
	// space into the grid one way or another. Instead, we nudge
	// #fighting-text's own font size up or down by a small amount so its
	// rendered height matches the tile grid's height exactly — no grid
	// track sizing tricks, no layout restructuring, nothing that touches
	// the 1024px/850px/680px breakpoints below, since this is skipped
	// entirely outside the desktop 3-row layout.
	function fitFightingText() {
		var text = document.getElementById("fighting-text");
		var questioning = document.getElementById("questioning");
		var social = document.getElementById("social");
		if (!text || !questioning || !social) return;

		if (window.innerWidth <= 1024) {
			text.style.removeProperty("--text-fit-scale");
			text.style.removeProperty("--text-fit-line-scale");
			return;
		}

		var scale = 1;
		text.style.setProperty("--text-fit-scale", scale);
		text.style.setProperty("--text-fit-line-scale", 1);

		// Pass 1: get close by nudging font-size. Re-measure the available
		// height on every iteration, not just once — shrinking/growing
		// #fighting-text also tightens/loosens the tile grid's own row
		// gaps (that's the whole reason this script exists), so the
		// target itself moves as we adjust. Text height also responds
		// close to linearly to small font-size changes, but not exactly —
		// line-wrapping happens in whole-line jumps, so this alone
		// plateaus with a small residual gap rather than landing exactly.
		for (var i = 0; i < 12; i++) {
			var availableHeight = social.getBoundingClientRect().bottom - questioning.getBoundingClientRect().top;
			var currentHeight = text.scrollHeight;
			if (!currentHeight) break;
			var ratio = availableHeight / currentHeight;
			if (Math.abs(ratio - 1) < 0.001) break;
			scale = scale * ratio;
			// "Just a little" — clamp so text never gets cramped or
			// oversized even if content is edited to be much
			// shorter/longer later.
			scale = Math.max(0.75, Math.min(1.25, scale));
			text.style.setProperty("--text-fit-scale", scale);
		}

		// Pass 2: close the exact remaining pixels with a small line-height
		// nudge instead of font-size. Unlike font-size, line-height doesn't
		// re-trigger word-wrapping, so distributing the leftover gap across
		// each line of text lands on an exact match rather than plateauing.
		// Line count is estimated from the text elements only (not the two
		// images also inside #fighting-text), or the estimate is wildly
		// too high and the correction ends up far too small to matter.
		// Looped for the same reason as pass 1: adjusting line-height also
		// changes the tile grid's own row gaps, moving the target slightly,
		// so one more small correction is needed after the first big one.
		for (var k = 0; k < 3; k++) {
			var availableHeight2 = social.getBoundingClientRect().bottom - questioning.getBoundingClientRect().top;
			var currentTextHeight = text.scrollHeight;
			var remaining = availableHeight2 - currentTextHeight;
			if (Math.abs(remaining) < 0.5) break;

			var textEls = text.querySelectorAll("p, blockquote");
			var totalTextHeight = 0;
			for (var j = 0; j < textEls.length; j++) {
				totalTextHeight += textEls[j].getBoundingClientRect().height;
			}
			var lineHeightPx = parseFloat(getComputedStyle(text.querySelector("p")).lineHeight) || 0;
			if (!lineHeightPx || !totalTextHeight) break;

			var approxLineCount = totalTextHeight / lineHeightPx;
			if (approxLineCount <= 0) break;

			var currentLineScale = parseFloat(getComputedStyle(text).getPropertyValue("--text-fit-line-scale")) || 1;
			var perLineAdjustment = remaining / approxLineCount;
			var lineScale = currentLineScale + perLineAdjustment / lineHeightPx;
			lineScale = Math.max(0.8, Math.min(1.2, lineScale));
			text.style.setProperty("--text-fit-line-scale", lineScale);
		}
	}

	window.addEventListener("load", fitFightingText);
	var resizeTimer;
	window.addEventListener("resize", function () {
		clearTimeout(resizeTimer);
		resizeTimer = setTimeout(fitFightingText, 150);
	});
})();
</script>
